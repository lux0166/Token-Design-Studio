{
  "name": "token-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "mcp": "tsx server/stdio.ts",
    "skill:install": "node scripts/install-skill.mjs",
    "english:dev": "npm --prefix apps/english-one run dev",
    "english:build": "npm --prefix apps/english-one run build",
    "english:test": "npm --prefix apps/english-one test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "culori": "^4.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
