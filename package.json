{
  "name": "token-design-studio",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run skill:build && tsc -b && vite build && node scripts/build-runtime.mjs",
    "skill:build": "tsx scripts/build-skill.mjs",
    "pack:skill": "npm run skill:build && node scripts/pack-skill.mjs",
    "test:skill-package": "node scripts/verify-skill-package.mjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "mcp": "tsx server/stdio.ts",
    "skill:install": "node scripts/install-skill.mjs",
    "english:dev": "npm --prefix apps/english-one run dev",
    "english:build": "npm --prefix apps/english-one run build",
    "english:test": "npm --prefix apps/english-one test",
    "prepack": "npm run build",
    "pack:local": "node scripts/pack.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "culori": "^4.0.2",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/culori": "^4.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "description": "Local-first theme editor, MCP server and design workflow for shadcn/ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lux0166/Token-Design-Studio.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "token-design-studio": "bin/token-design-studio.mjs"
  },
  "files": [
    "bin/",
    "cli/",
    "runtime/server.js",
    "runtime/stdio.js",
    "runtime/data.js",
    "dist/",
    "skills/token-studio-shadcn/",
    "third_party/",
    "LICENSE",
    "README.md"
  ]
}
